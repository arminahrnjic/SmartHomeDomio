# Google Apps Script Web App URL koji upisuje preorder/newsletter prijave u Google Sheet.
# Vidi SETUP.md za korake kako da ovo napravis.
NEXT_PUBLIC_SHEETS_ENDPOINT=

# Puni URL live sajta (npr. https://smarthome.vercel.app ili prava domena kad se kupi).
# Koristi se za SEO metadata (Open Graph, sitemap.xml, robots.txt). Bez ovoga te tagove
# vidi samo lokalni fallback, ne pravi URL.
NEXT_PUBLIC_SITE_URL=
